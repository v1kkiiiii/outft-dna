{
  "expo": {
    "name": "outft.",
    "slug": "outft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.outft.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.outft.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "OUTFT needs access to your photos so you can select an outfit to analyze."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OUTFT uses the camera so you can capture your outfit."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "OUTFT saves photos and receipts to your camera roll when you choose to."
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3e7d2572-c8f7-4237-94ac-938916cd4f1d"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "sahanalydia",
    "updates": {
      "url": "https://u.expo.dev/3e7d2572-c8f7-4237-94ac-938916cd4f1d"
    }
  }
}
