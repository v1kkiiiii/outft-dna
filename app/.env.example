# Copy to .env for local development — never commit the real .env.
# The app talks only to Supabase; the Anthropic key lives server-side
# in the worker, never in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Analysis server and website
EXPO_PUBLIC_ANALYZE_URL=https://outft-dna-production.up.railway.app/api/analyze
EXPO_PUBLIC_WEBSITE_URL=https://outft.app
# Flags (1 = on)
EXPO_PUBLIC_FLAG_ONBOARDING=1
EXPO_PUBLIC_FLAG_SHARPEN_PROMPT=0
EXPO_PUBLIC_SHARPEN_TESTERS=
EXPO_PUBLIC_FLAG_PRICING=0
EXPO_PUBLIC_FLAG_REENGAGEMENT=0
EXPO_PUBLIC_FLAG_QUEUE_PIPELINE=0
